<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_ai_config_list" model="ir.ui.view">
        <field name="name">ai.config.list</field>
        <field name="model">ai.config</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="provider"/>
                <field name="is_default"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_ai_config_form" model="ir.ui.view">
        <field name="name">ai.config.form</field>
        <field name="model">ai.config</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="provider"/>
                            <field name="api_key" password="True"/>
                            <field name="base_url"/>
                        </group>
                        <group>
                            <field name="bot_name"/>
                            <field name="bot_image" widget="image"/>
                            <field name="is_default"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Modelos LLM">
                            <field name="model_ids">
                                <list editable="bottom">
                                    <field name="name"/>
                                    <field name="label"/>
                                    <field name="active"/>
                                    <field name="is_default"/>
                                </list>
                            </field>
                        </page>
                        <page string="Modelos Odoo permitidos">
                            <field name="allowed_model_ids" widget="many2many_tags"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_ai_config" model="ir.actions.act_window">
        <field name="name">Configuración de Modelos</field>
        <field name="res_model">ai.config</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
