<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="partner_ai_assistant" model="res.partner">
            <field name="name">Asistente IA</field>
            <field name="is_company">False</field>
            <field name="active">True</field>
            <field name="comment">Bot interno para consultas sobre datos de Odoo.</field>
        </record>

        <record id="user_ai_assistant" model="res.users">
            <field name="name">Asistente IA</field>
            <field name="login">ai_assistant_bot</field>
            <field name="partner_id" ref="partner_ai_assistant"/>
            <field name="group_ids" eval="[(4, ref('base.group_user'))]"/>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
